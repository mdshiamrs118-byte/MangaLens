<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MangaLens" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/on_bg</item>
        <item name="android:textColorSecondary">@color/on_muted</item>
        <item name="alertDialogTheme">@style/Theme.MangaLens.Dialog</item>
    </style>

    <style name="Theme.MangaLens.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/surface</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/on_bg</item>
    </style>
</resources>
